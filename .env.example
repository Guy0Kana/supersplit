# Copy to .env on the server. Never commit .env.
NODE_ENV=production
PORT=3001

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Encrypts keys saved from the Admin tab (AES-256-GCM). Different value from SESSION_SECRET.
SETTINGS_SECRET=

# SQLite file. Staging should use its own file.
DB_PATH=./data/app.db

# Optional: keys can also be pasted into the Admin tab instead of set here.
GEMINI_API_KEY=
# Use the model name shown in Google AI Studio. Names and free-tier limits change.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CAP=40
GEMINI_DELAY_MS=6000
NVD_API_KEY=

# Set to false on staging so only production calls the free APIs.
RUN_JOBS=true
